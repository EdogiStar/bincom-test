<!DOCTYPE html><html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bincom Election Results Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
        }    .hidden {
        display: none;
    }
</style>

</head><body class="min-h-screen bg-slate-100 text-slate-800">
    <header class="bg-slate-900 text-white shadow-lg">
        <div class="mx-auto max-w-7xl px-5 py-6">
            <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400">
                Election Data Portal
            </p>
            <h1 class="mt-2 text-3xl font-bold">Bincom Election Results</h1>
            <p class="mt-2 text-slate-300">
                Explore aggregated election results by Local Government Area.
            </p>
        </div>
    </header><main class="mx-auto max-w-7xl space-y-6 px-5 py-8">
    <section class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="text-xl font-bold">Find Election Results</h2>
        <p class="mt-2 text-sm text-slate-500">
            Select a state and an LGA to view its aggregated results.
        </p>

        <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label for="stateSelect" class="mb-2 block text-sm font-semibold">
                    State
                </label>

                <select
                    id="stateSelect"
                    class="w-full rounded-lg border border-slate-300 bg-white px-4 py-3 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-100"
                >
                    <option value="">Select a state</option>
                    <% if (typeof states !== 'undefined' && Array.isArray(states)) { %>
                        <% states.forEach(state => { %>
                            <option value="<%= state.id %>">
                                <%= state.name %>
                            </option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div>
                <label for="lgaSelect" class="mb-2 block text-sm font-semibold">
                    Local Government Area
                </label>

                <select
                    id="lgaSelect"
                    disabled
                    class="w-full rounded-lg border border-slate-300 bg-slate-100 px-4 py-3 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-100 disabled:cursor-not-allowed"
                >
                    <option value="">Select a state first</option>
                </select>
            </div>
        </div>

        <div
            id="statusBox"
            role="status"
            aria-live="polite"
            class="mt-5 hidden rounded-lg px-4 py-3 text-sm"
        ></div>
    </section>

    <section id="resultsSection" class="hidden space-y-6">
        <div class="rounded-xl bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-slate-500">Total Aggregated Votes</p>
            <p id="totalVotes" class="mt-2 text-4xl font-bold text-emerald-700">0</p>
            <p id="selectedLgaName" class="mt-2 text-sm text-slate-500"></p>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 px-6 py-5">
                <h2 class="text-xl font-bold">Results by Political Party</h2>
                <p class="mt-1 text-sm text-slate-500">
                    Aggregated votes recorded for the selected LGA.
                </p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                        <tr>
                            <th class="px-6 py-4">#</th>
                            <th class="px-6 py-4">Party</th>
                            <th class="px-6 py-4 text-right">Total Votes</th>
                        </tr>
                    </thead>
                    <tbody id="resultsTable" class="divide-y divide-slate-100">
                    </tbody>
                </table>
            </div>

            <div id="emptyResults" class="hidden px-6 py-8 text-center text-slate-500">
                No election results were found for this LGA.
            </div>
        </div>
    </section>

    <footer class="py-4 text-center text-xs text-slate-400">
        Bincom Election Results · Aggregated election data
    </footer>
</main>

<script>
    const stateSelect = document.getElementById('stateSelect');
    const lgaSelect = document.getElementById('lgaSelect');
    const statusBox = document.getElementById('statusBox');
    const resultsSection = document.getElementById('resultsSection');
    const totalVotesElement = document.getElementById('totalVotes');
    const selectedLgaName = document.getElementById('selectedLgaName');
    const resultsTable = document.getElementById('resultsTable');
    const emptyResults = document.getElementById('emptyResults');

    function setStatus(message, type = 'info') {
        statusBox.textContent = message;
        statusBox.classList.remove(
            'hidden',
            'bg-blue-50',
            'text-blue-700',
            'bg-emerald-50',
            'text-emerald-700',
            'bg-red-50',
            'text-red-700'
        );

        const styles = {
            info: ['bg-blue-50', 'text-blue-700'],
            success: ['bg-emerald-50', 'text-emerald-700'],
            error: ['bg-red-50', 'text-red-700']
        };

        (styles[type] || styles.info).forEach(style => {
            statusBox.classList.add(style);
        });
    }

    function clearResults() {
        resultsSection.classList.add('hidden');
        resultsTable.replaceChildren();
        totalVotesElement.textContent = '0';
        selectedLgaName.textContent = '';
        emptyResults.classList.add('hidden');
    }

    function formatNumber(value) {
        const number = Number(value);
        return Number.isFinite(number)
            ? number.toLocaleString('en-NG')
            : '0';
    }

    stateSelect.addEventListener('change', async () => {
        const stateId = stateSelect.value;

        lgaSelect.replaceChildren();
        lgaSelect.disabled = true;
        clearResults();

        if (!stateId) {
            lgaSelect.add(new Option('Select a state first', ''));
            statusBox.classList.add('hidden');
            return;
        }

        lgaSelect.add(new Option('Loading LGAs...', ''));
        setStatus('Loading Local Government Areas...', 'info');

        try {
            const response = await fetch(
                `/api/lgas?state_id=${encodeURIComponent(stateId)}`,
                {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    },
                    cache: 'no-store'
                }
            );

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (!result.success || !Array.isArray(result.data)) {
                throw new Error('The server returned an unexpected response.');
            }

            lgaSelect.replaceChildren();
            lgaSelect.add(new Option('Select an LGA', ''));

            result.data.forEach(lga => {
                lgaSelect.add(new Option(lga.name, lga.id));
            });

            lgaSelect.disabled = false;

            setStatus(
                `Successfully loaded ${result.data.length} LGAs.`,
                'success'
            );
        } catch (error) {
            console.error('Error loading LGAs:', error);

            lgaSelect.replaceChildren();
            lgaSelect.add(new Option('Unable to load LGAs', ''));
            lgaSelect.disabled = true;

            setStatus(`Failed to load LGAs: ${error.message}`, 'error');
        }
    });

    lgaSelect.addEventListener('change', async () => {
        const lgaId = lgaSelect.value;
        const lgaName = lgaSelect.options[lgaSelect.selectedIndex]?.text || '';

        clearResults();

        if (!lgaId) {
            return;
        }

        setStatus('Loading election results...', 'info');

        try {
            const response = await fetch(
                `/api/results/lga/${encodeURIComponent(lgaId)}`,
                {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    },
                    cache: 'no-store'
                }
            );

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (!result.success || !Array.isArray(result.data)) {
                throw new Error('The server returned an unexpected response.');
            }

            const rows = result.data;
            const totalVotes = rows.reduce(
                (sum, row) => sum + Number(row.total_votes || 0),
                0
            );

            totalVotesElement.textContent = formatNumber(totalVotes);
            selectedLgaName.textContent = `Local Government Area: ${lgaName}`;

            resultsTable.replaceChildren();

            rows.forEach((row, index) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50';

                const numberCell = document.createElement('td');
                numberCell.className = 'px-6 py-4 text-slate-500';
                numberCell.textContent = String(index + 1);

                const partyCell = document.createElement('td');
                partyCell.className = 'px-6 py-4 font-semibold text-slate-800';
                partyCell.textContent = row.party_abbreviation || 'Unknown';

                const votesCell = document.createElement('td');
                votesCell.className = 'px-6 py-4 text-right font-semibold';
                votesCell.textContent = formatNumber(row.total_votes);

                tr.append(numberCell, partyCell, votesCell);
                resultsTable.appendChild(tr);
            });

            emptyResults.classList.toggle('hidden', rows.length !== 0);
            resultsSection.classList.remove('hidden');

            setStatus('Election results loaded successfully.', 'success');
        } catch (error) {
            console.error('Error loading election results:', error);
            setStatus(`Failed to load election results: ${error.message}`, 'error');
        }
    });
</script>

</body>
</html>